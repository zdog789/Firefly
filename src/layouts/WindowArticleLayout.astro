---
import EnvironmentBackground from "@/components/desktop/EnvironmentBackground.svelte";
import DesktopLayout from "./DesktopLayout.astro";
import "@/styles/main.css";
import "@/styles/variables.styl";
import "@/styles/expressive-code.css";

interface Props {
	title: string;
	description: string;
	image?: string;
	lang: string;
}

const { title, description, image, lang } = Astro.props;
---

<DesktopLayout {title} {description} {image} {lang} article>
  <slot name="head" slot="head" />
  <main class="article-page">
    <EnvironmentBackground />
    <slot />
  </main>
</DesktopLayout>
